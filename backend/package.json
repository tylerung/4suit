{
  "name": "4suit-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "4suit API — Express + MongoDB service behind the 4suit client.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/db/seed-cli.ts",
    "test": "tsx tests/api.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.9.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "mongodb-memory-server": "^11.2.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
